    "@boltvault/wallet": "workspace:*",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.1",
    "@types/react": "~19.2.2",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^5.0.0",
    "happy-dom": "^20.14.0",
    "typescript": "^5.6.3",
    "vite": "^7.1.0",
    "vitest": "^2.1.8",
    "wxt": "^0.21.4"
  }
