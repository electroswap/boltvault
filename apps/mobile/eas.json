{
  "cli": { "version": ">= 16.0.0", "appVersionSource": "remote" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": { "EXPO_PUBLIC_BOLTVAULT_API": "https://electroswap.io" }
    },
    "internal": {
      "distribution": "internal",
      "channel": "internal",
      "ios": { "simulator": false },
      "android": { "buildType": "apk" },
      "env": { "EXPO_PUBLIC_BOLTVAULT_API": "https://electroswap.io" }
    },
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "env": { "EXPO_PUBLIC_BOLTVAULT_API": "https://electroswap.io" }
    }
  },
  "submit": {
    "production": {
      "ios": { "ascAppId": "REPLACE_WITH_APP_STORE_CONNECT_ID" },
      "android": { "track": "internal", "serviceAccountKeyPath": "./play-service-account.json" }
    }
  }
}
