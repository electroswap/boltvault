{
  "expo": {
    "name": "BoltVault",
    "slug": "boltvault",
    "scheme": "boltvault",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#070A1F",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "io.electroswap.boltvault",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "BoltVault scans QR codes: a Keystone signer, a paired device, a WalletConnect link.",
        "NSBluetoothAlwaysUsageDescription": "BoltVault talks to a Ledger over Bluetooth to sign with it.",
        "NSFaceIDUsageDescription": "Unlock BoltVault with Face ID.",
        "UIBackgroundModes": [
          "remote-notification"
        ],
        "NSSupportsLiveActivities": true
      },
      "associatedDomains": [
        "applinks:wallet.electroswap.io",
        "webcredentials:wallet.electroswap.io"
      ],
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.io.electroswap.boltvault"
        ],
        "aps-environment": "production"
      }
    },
    "android": {
      "package": "io.electroswap.boltvault",
      "adaptiveIcon": {
        "backgroundColor": "#070A1F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "allowBackup": false,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.USE_BIOMETRIC",
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "wallet.electroswap.io",
              "pathPrefix": "/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "wc"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "ethereum"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "plugins": [
      [
        "expo-font",
        {
          "fonts": [
            "./node_modules/@expo-google-fonts/sora/400Regular/Sora_400Regular.ttf",
            "./node_modules/@expo-google-fonts/sora/600SemiBold/Sora_600SemiBold.ttf",
            "./node_modules/@expo-google-fonts/oxanium/400Regular/Oxanium_400Regular.ttf",
            "./node_modules/@expo-google-fonts/oxanium/600SemiBold/Oxanium_600SemiBold.ttf"
          ],
          "android": {
            "fonts": [
              {
                "fontFamily": "Sora",
                "fontDefinitions": [
                  {
                    "path": "./node_modules/@expo-google-fonts/sora/400Regular/Sora_400Regular.ttf",
                    "weight": 400
                  },
                  {
                    "path": "./node_modules/@expo-google-fonts/sora/600SemiBold/Sora_600SemiBold.ttf",
                    "weight": 600
                  }
                ]
              },
              {
                "fontFamily": "Oxanium",
                "fontDefinitions": [
                  {
                    "path": "./node_modules/@expo-google-fonts/oxanium/400Regular/Oxanium_400Regular.ttf",
                    "weight": 400
                  },
                  {
                    "path": "./node_modules/@expo-google-fonts/oxanium/600SemiBold/Oxanium_600SemiBold.ttf",
                    "weight": 600
                  }
                ]
              }
            ]
          }
        }
      ],
      "react-native-libsodium",
      [
        "expo-camera",
        {
          "cameraPermission": "BoltVault scans QR codes: a Keystone signer, a paired device, a WalletConnect link."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#4FC3FF",
          "defaultChannel": "boltvault"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Unlock BoltVault with Face ID."
        }
      ],
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": false,
          "modes": [
            "central"
          ],
          "bluetoothAlwaysPermission": "BoltVault talks to a Ledger over Bluetooth to sign with it."
        }
      ],
      "expo-audio",
      "./plugins/withWidgets.js",
      "./plugins/withUsbHost.js",
      "./plugins/withTaskIsolation.js",
      "./plugins/withNativeSplash.js",
      "./plugins/withBuildTuning.js",
      "./plugins/withReleaseSigning.js"
    ],
    "extra": {
      "eas": {
        "projectId": "REPLACE_WITH_EAS_PROJECT_ID"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
