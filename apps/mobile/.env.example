# BoltVault mobile — local build configuration.
#
# Copy to `.env` (gitignored) and fill in. Expo loads `.env` from this
# directory and inlines every `EXPO_PUBLIC_*` value at bundle time, so a change
# here needs a rebuild of the JS bundle, not just a reload.
#
#   cp apps/mobile/.env.example apps/mobile/.env
#
# On an Android emulator the host machine is 10.0.2.2, not localhost — the
# emulator's own loopback is the emulator.

# Which API the wallet talks to. Defaults to https://electroswap.io when unset.
EXPO_PUBLIC_BOLTVAULT_API=https://electroswap.io

# The wallet API key (§9.1). Signed rather than sent on every API call
# (`X-BoltVault-Auth`); the routing service below is the one exception and
# receives the key itself. See apps/extension/.env.example for what it is and is
# not; the same value works for both bodies against the same API, and it must
# match the API's `BOLT_WALLET_API_KEY` exactly or every wallet route 401s.
EXPO_PUBLIC_BOLTVAULT_KEY=

# Where the routing service lives (§8.6). Empty derives `/routing/quote` from the
# API origin, which is right for a release. A locally-run quoter
# (`services/quoter-api`) serves `/api/quote` on port 3007 instead — and on an
# Android emulator the host is 10.0.2.2, so that reads
# EXPO_PUBLIC_QUOTER_URL=http://10.0.2.2:3007/api/quote
# A quote that fails for any reason falls back to the on-chain mini-router.
EXPO_PUBLIC_QUOTER_URL=

# Turn on limit orders in this build.
EXPO_PUBLIC_BOLTVAULT_LIMIT_ORDERS=0

# The version is NOT here. It lives in `version.json` at the repo root, which
# `app.config.ts` and `App.tsx` both read, so the phone, the extension and the
# store listing cannot disagree. Change it with `node tools/version.mjs <x.y.z>`.
