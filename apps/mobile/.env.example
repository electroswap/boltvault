# BoltVault mobile — local build configuration.
#
# Copy to `.env` (gitignored) and fill in. Expo loads `.env` from this
# directory and inlines every `EXPO_PUBLIC_*` value at bundle time, so a change
# here needs a rebuild of the JS bundle, not just a reload.
#
#   cp apps/mobile/.env.example apps/mobile/.env
#
# On an Android emulator the host machine is 10.0.2.2, not localhost — the
# emulator's own loopback is the emulator.

# Which API the wallet talks to. Defaults to https://electroswap.io when unset.
EXPO_PUBLIC_BOLTVAULT_API=https://electroswap.io

# The wallet API key (§9.1). Not sent — each request is signed with it
# (`X-BoltVault-Auth`). See apps/extension/.env.example for what it is and is
# not; the same value works for both bodies against the same API, and it must
# match the API's `BOLT_WALLET_API_KEY` exactly or every wallet route 401s.
EXPO_PUBLIC_BOLTVAULT_KEY=

# Turn on limit orders in this build.
EXPO_PUBLIC_BOLTVAULT_LIMIT_ORDERS=0

# Shown in About and sent as the client version.
EXPO_PUBLIC_APP_VERSION=0.1.0
