apps/extension/.output/
apps/extension/screenshots/
apps/mobile/android/
apps/mobile/ios/
build/
# …except the EAS custom build configs, which only exist as source and which
# EAS reads out of the uploaded git archive: ignored, they are simply not there
# on the builder and the job fails looking for them.
!apps/mobile/.eas/build/
coverage/
dist/
.DS_Store
e2e-results/
.expo/
.expo-export/
*.log
node_modules/
.out/
pnpm-lock.yaml.lock
.turbo/

rebuild-*.sh

# Local build configuration: the API origin and the wallet API key a developer
# builds against. `.env.example` is the committed template; `.env` is yours and
# holds a real key, so it never leaves the machine.
.env
.env.local
.env.*.local
!.env.example

# Internal working documents, not published
internal-docs/
